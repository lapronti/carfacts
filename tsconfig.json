{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "lib": [
      "ES2022"
    ],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/contracts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tests"
  ]
}
